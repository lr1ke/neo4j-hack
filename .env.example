# Neo4j Aura Free — copy this file to .env and fill in your instance
# credentials (from the "Connect" panel in the Aura console, or the .txt
# file it offers to download when you create the instance).

NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-generated-password

# Anthropic — used only for reflection narration (Claude Haiku). Optional:
# without it, run-reflection.mjs prints raw graph evidence and skips narration.
# console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
